<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression: everything. Runs nightly and before releases. -->
<suite name="Regression" parallel="methods" thread-count="4" data-provider-thread-count="2">
    <listeners>
        <listener class-name="io.github.carolpapi.tests.listeners.RetryTransformer"/>
        <listener class-name="io.github.carolpapi.tests.listeners.ExecutionLogListener"/>
    </listeners>
    <test name="API">
        <packages><package name="io.github.carolpapi.tests.api"/></packages>
    </test>
    <test name="UI">
        <packages><package name="io.github.carolpapi.tests.ui"/></packages>
    </test>
</suite>
